#!/usr/bin/env python3
"""Test-only bitcoind → rbitcoin-node adapter. Not the operator CLI.

Maps Core TestNode argv + bitcoin.conf onto rbitcoin-node flags.
`-datadir=DIR` becomes `--datadir DIR/regtest` so the cookie lands at
`DIR/regtest/.cookie` (what BitcoinTestFramework tails).

Tests speak to a JSON-RPC proxy on `-rpcport`. The node listens on
`rpcport+10000` and Esplora on `rpcport+20000` (not node-RPC+1: Core
gives consecutive rpcports, so that collided across nodes).
"""

from __future__ import annotations

import os
import re
import shutil
import signal
import subprocess
import sys
import threading
from pathlib import Path

from map_debuglog import apply_line, load_rules
from rpc_proxy import RpcProxy, esplora_port, node_rpc_port
from rpc_util import register_utility
from rpc_wallet import register_wallet

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]


def parse_kv(arg: str) -> tuple[str, str | None]:
    a = arg[1:] if arg.startswith("-") else arg
    # Core uses -name or -name=value (one dash). Allow --name too.
    a = a[1:] if a.startswith("-") else a
    if "=" in a:
        k, v = a.split("=", 1)
        return k, v
    return a, None


def parse_port(raw: str | None, flag: str) -> str:
    s = "" if raw is None else str(raw)
    if re.fullmatch(r"[0-9]+", s) is None:
        print(f"Error: Invalid port specified in {flag}: '{s}'", file=sys.stderr)
        raise SystemExit(1)
    n = int(s)
    if n < 1 or n > 65535:
        print(f"Error: Invalid port specified in {flag}: '{s}'", file=sys.stderr)
        raise SystemExit(1)
    return str(n)


