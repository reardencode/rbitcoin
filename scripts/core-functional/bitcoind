def forward_flag(key: str, val: str | None) -> str:
    if val is None:
        return f"--{key}"
    return f"--{key}={val}"


def read_conf(path: Path) -> dict[str, str]:
    """Read bitcoin.conf. Later [section] keys override earlier ones."""
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or line.startswith("["):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip().lower()] = v.strip()
    return out


def maybe_seed_store(node_dir: Path) -> None:
    """Copy the rbitcoin 199-block store into a Core cache-shaped datadir.

    Core `_initialize_chain` copies `blocks/` + `chainstate/` then starts the
    node. Those empty dirs are the signal that this is a cached start, not a
    clean chain. We never copy Core LevelDB; only our `store/`.
    """
    cache = os.environ.get("RBITCOIN_CACHE")
    if not cache:
        return
    src = Path(cache) / "store"
    dest = node_dir / "store"
    if dest.exists() or not src.is_dir():
        return
    if not ((node_dir / "blocks").is_dir() and (node_dir / "chainstate").is_dir()):
        return
    shutil.copytree(src, dest)


def find_node() -> Path:
    env = os.environ.get("RBITCOIN_NODE")
    if env:
        p = Path(env)
        if not p.is_absolute():
            p = ROOT / p
        if p.is_file():
            return p
        raise SystemExit(f"RBITCOIN_NODE={env} is not a file")
    cands: list[Path] = []
    td = os.environ.get("CARGO_TARGET_DIR")
    if td:
        cands += [Path(td) / "debug" / "rbitcoin-node", Path(td) / "release" / "rbitcoin-node"]
    cands += [
        ROOT / "target/dev/debug/rbitcoin-node",
        ROOT / "target/debug/rbitcoin-node",
    ]
    for c in cands:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    which = shutil.which("rbitcoin-node")
    if which:
        return Path(which)
    raise SystemExit(
        "rbitcoin-node not found; set RBITCOIN_NODE or cargo build -p rbitcoin-node"
    )


_LOG_RANK = {
    "error": 1,
    "warn": 2,
    "warning": 2,
    "info": 3,
    "debug": 4,
    "trace": 5,
}


def _more_verbose_log_level(cur: str | None, new: str) -> str | None:
    if new not in _LOG_RANK:
        return cur
    if cur is None or _LOG_RANK[new] > _LOG_RANK.get(cur, 0):
        return new
    return cur


def _parse_bind(val: str) -> tuple[str, int | None, bool]:
    """Parse Core -bind=HOST[:PORT][=onion] → (host, port_or_None, is_onion)."""
    onion = "=onion" in val
    hostport = val.split("=", 1)[0]
    if ":" in hostport:
        host, port_s = hostport.rsplit(":", 1)
        try:
            return host, int(port_s), onion
        except ValueError:
            return hostport, None, onion
    return hostport, None, onion


def translate(
    argv: list[str],
) -> tuple[list[str], Path, int, Path | None, Path | None, str | None, list[str]]:
    """Return (node argv, datadir, rpcport, blocksdir, walletdir, wallet, bound_lines)."""
    datadir: Path | None = None
    rpcport: str | None = None
    p2pport: str | None = None
    network = "regtest"
    log_level: str | None = None
    want_help = False
    want_version = False
    uacomments: list[str] = []
    extra_node_args: list[str] = []
    wipe_mempool = False
    blocksdir_arg: Path | None = None
    walletdir_arg: Path | None = None
    wallet_name: str | None = None
    # Core-shaped bind announcements for debug.log (feature_port.py).
    binds: list[tuple[str, int | None, bool]] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("--print-cmd",):
            i += 1
            continue
        key, val = parse_kv(a)
        # Core `-nofoo` / `-nofoo=1` is foo=false; `-nofoo=0` is foo=true.
        no_bases = FORWARD_FLAGS | IGNORE_FLAGS | {"txindex", "maxconnections"}
        if key.startswith("no") and key[2:] in no_bases:
            base = key[2:]
            if val is None or str(val).lower() in ("1", "true", "yes", "on"):
                key, val = base, "0"
            elif str(val).lower() in ("0", "false", "no", "off"):
                key, val = base, "1"
            else:
                key, val = base, "0"
        if val is None and key in (
            "datadir",
            "rpcport",
            "port",
            "bind",
            "uacomment",
            "loglevel",
            "conf",
            "testactivationheight",
            "whitelist",
            "minrelaytxfee",
            "limitclustercount",
            "limitclustersize",
            "peertimeout",
            "maxconnections",
            "minimumchainwork",
            "maxtipage",
            "mocktime",
            "blockversion",
            "blockmintxfee",
            "blockmaxweight",
            "blockreservedweight",
            "stopatheight",
            "blocksdir",
            "walletdir",
            "wallet",
        ):
            i += 1
            if i >= len(argv):
                raise SystemExit(f"bitcoind: {a} requires a value")
            val = argv[i]
        if key == "datadir":
            datadir = Path(val or "")
        elif key == "blocksdir":
            blocksdir_arg = Path(val or "")
            if not blocksdir_arg.is_dir():
                print(
                    f'Error: Specified blocks directory "{blocksdir_arg}" does not exist.',
                    file=sys.stderr,
                )
                raise SystemExit(1)
        elif key == "walletdir":
            walletdir_arg = Path(val or "")
        elif key == "wallet":
            wallet_name = val or ""
        elif key == "rpcport":
            rpcport = parse_port(val, "-rpcport")
        elif key == "port":
            p2pport = parse_port(val, "-port")
        elif key == "bind" and val:
            host, bport, onion = _parse_bind(val)
            binds.append((host, bport, onion))
            # Non-onion bind with an explicit port supplies the P2P listen port.
            if not onion and bport is not None:
                p2pport = str(bport)
        elif key == "regtest":
            network = "regtest"
        elif key == "uacomment":
            uacomments.append(val or "")
        elif key in ("h", "help"):
            want_help = True
        elif key == "version":
            want_version = True
        elif key == "debug":
            log_level = _more_verbose_log_level(log_level, "debug")
        elif key == "loglevel" and val and ":" not in val:
            log_level = _more_verbose_log_level(log_level, val.lower())
        elif key == "txindex":
            # Class A always looks up by txid. `-txindex` / `=1` is already true.
            # `-txindex=0` cannot be honored.
            if val is not None and val.lower() in ("0", "false", "off", "no"):
                print("Error parsing command line arguments", file=sys.stderr)
                raise SystemExit(1)
        elif key == "persistmempool":
            # Core -persistmempool=0 skips load/dump; wipe so a later default
            # restart cannot reload a stale dump (mining_basic.py).
            if val is not None and str(val).lower() in ("0", "false", "off", "no"):
                wipe_mempool = True
            extra_node_args.append(forward_flag(key, val))
        elif key in IGNORE_FLAGS:
            pass
        elif key in FORWARD_FLAGS:
            extra_node_args.append(forward_flag(key, val))
        elif key == "maxconnections":
            extra_node_args.append(
                f"--maxconnections={val}" if val is not None else "--maxconnections"
            )
        else:
            print("Error parsing command line arguments", file=sys.stderr)
            raise SystemExit(1)
        i += 1

    if want_help:
        print("Options")
        print("rbitcoin-node (test-only bitcoind shim)")
        raise SystemExit(0)
    if want_version:
        print("rbitcoin-node version")
        raise SystemExit(0)

    if datadir is None:
        raise SystemExit("bitcoind: -datadir is required")

    conf = read_conf(datadir / "bitcoin.conf")
    if conf.get("regtest") in ("1", "true"):
        network = "regtest"
    if rpcport is None:
        rpcport = parse_port(conf.get("rpcport") or "18443", "-rpcport")
    if p2pport is None:
        p2pport = parse_port(conf.get("port") or "18444", "-port")

    node_dir = datadir / network
    node_dir.mkdir(parents=True, exist_ok=True)
    maybe_seed_store(node_dir)

    mp = node_dir / "mempool"
    marker = node_dir / ".rbitcoin-nopersistmempool"
    # Core -persistmempool=0 is RAM-only; our store still coalesces admits.
    # Wipe on =0 start, and once more on the next default start so a stale
    # dump cannot reload (mining_basic.py empty-mempool gate).
    if wipe_mempool or marker.is_file():
        if mp.exists():
            shutil.rmtree(mp, ignore_errors=True)
        if wipe_mempool:
            marker.write_text("1\n")
        else:
            marker.unlink(missing_ok=True)
    # Core-layout placeholders: default datadir/blocks for getblockstats rename;
    # with -blocksdir, also blk under blocksdir/<network>/blocks (feature_blocksdir).
    blocks_dir = node_dir / "blocks"
    blocks_dir.mkdir(parents=True, exist_ok=True)
    (blocks_dir / "index").mkdir(parents=True, exist_ok=True)
    blk0 = blocks_dir / "blk00000.dat"
    if not blk0.is_file():
        blk0.write_bytes(b"\x00" * 16)
    if blocksdir_arg is not None:
        bd_blocks = blocksdir_arg / network / "blocks"
        bd_blocks.mkdir(parents=True, exist_ok=True)
        bd_blk = bd_blocks / "blk00000.dat"
        if not bd_blk.is_file():
            bd_blk.write_bytes(b"\x00" * 16)

    node = find_node()
    cmd = [
        str(node),
        "--network",
        network,
        "--datadir",
        str(node_dir),
        "--rpc-listen",
        f"127.0.0.1:{node_rpc_port(int(rpcport))}",
        "--listen",
        f"127.0.0.1:{p2pport}",
        "--no-seeds",
        "--shindex",
        "--esplora-listen",
        f"127.0.0.1:{esplora_port(int(rpcport))}",
    ]
    # Core `-bind=host:port=onion` → extra listen sockets (getaddr caching).
    for host, bport, onion in binds:
        if not onion or bport is None:
            continue
        listen_host = "127.0.0.1" if host in ("0.0.0.0", "::") else host
        extra = f"{listen_host}:{bport}"
        if extra == f"127.0.0.1:{p2pport}":
            continue
        cmd += ["--listen", extra]
    if log_level:
        cmd += ["--log-level", log_level]
    for c in uacomments:
        cmd += [f"--uacomment={c}"]
    cmd += extra_node_args

    # Core debug.log "Bound to …" announcements (feature_port.py).
    port_n = int(p2pport)
    bound_lines: list[str] = []
    non_onion = [(h, p, o) for (h, p, o) in binds if not o]
    onion_binds = [(h, p, o) for (h, p, o) in binds if o]
    if non_onion:
        for host, bport, _ in non_onion:
            bound_lines.append(f"Bound to {host}:{bport if bport is not None else port_n}")
        for host, bport, _ in onion_binds:
            bound_lines.append(
                f"Bound to {host}:{bport if bport is not None else port_n + 1}"
            )
    else:
        bound_lines.append(f"Bound to 0.0.0.0:{port_n}")
        if onion_binds:
            for host, bport, _ in onion_binds:
                bound_lines.append(
                    f"Bound to {host}:{bport if bport is not None else port_n + 1}"
                )
        else:
            bound_lines.append(f"Bound to 127.0.0.1:{port_n + 1}")
    # Actual node listen (map_debuglog / prior harness expectation).
    bound_lines.append(f"Bound to 127.0.0.1:{port_n}")

    return (
        cmd,
        node_dir,
        int(rpcport),
        blocksdir_arg,
        walletdir_arg,
        wallet_name,
        bound_lines,
    )


def _try_dir_lock(path: Path, label: Path) -> object | None:
    """Exclusive flock; keep the file open. None → already locked (Core msg)."""
    import fcntl

    path.mkdir(parents=True, exist_ok=True)
    lock_path = path / ".lock"
    fh = open(lock_path, "a+", encoding="utf-8")
    try:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        print(
            f"Error: Cannot obtain a lock on directory {label}. "
            f"Bitcoin Core is probably already running.",
            file=sys.stderr,
        )
        return None
    return fh


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv if argv is None else argv)
    print_cmd = "--print-cmd" in argv
    (
        cmd,
        node_dir,
        public_rpc,
        blocksdir_arg,
        walletdir_arg,
        wallet_name,
        bound_lines,
    ) = translate(argv)
    pid_path = node_dir / "bitcoind.pid"
    if print_cmd:
        print(" ".join(cmd))
        print(f"pidfile {pid_path}", file=sys.stderr)
        return 0
    # Core datadir / blocksdir lock (feature_filelock.py).
    datadir_lock = _try_dir_lock(node_dir, node_dir)
    if datadir_lock is None:
        return 1
    # Default blocks path; -blocksdir=X → X/<network>/blocks (Core regtest shape).
    blocks_root = (
        (blocksdir_arg / "regtest" / "blocks")
        if blocksdir_arg is not None
        else (node_dir / "blocks")
    )
    blocks_lock = _try_dir_lock(blocks_root, blocks_root)
    if blocks_lock is None:
        datadir_lock.close()
        return 1
    # Wallet exclusive lock (feature_filelock.py). Opening another node's
    # walletdir (or a locked wallet path) must refuse with Core's SQLite text.
    if walletdir_arg is not None and wallet_name is not None:
        wpath = walletdir_arg / wallet_name
        foreign = False
        try:
            foreign = not walletdir_arg.resolve().is_relative_to(node_dir.resolve())
        except (OSError, ValueError, AttributeError):
            foreign = True
        wlock = _try_dir_lock(wpath, wpath)
        if foreign or wlock is None:
            print(
                "Error: SQLiteDatabase: Unable to obtain an exclusive lock on the database, "
                "is it being used by another instance of Bitcoin Core?",
                file=sys.stderr,
            )
            datadir_lock.close()
            blocks_lock.close()
            if wlock is not None:
                wlock.close()
            return 1
    pid_path.write_text(f"{os.getpid()}\n")
    # TestNode tails this process's stderr and requires it empty on a clean
    # stop. Core writes logs to debug.log (printtoconsole=0). Keep that shape:
    # node stdio → {datadir}/debug.log; only `Error:` lines on shim stderr.
    log_path = node_dir / "debug.log"
    prior = log_path.stat().st_size if log_path.is_file() else 0
    log_f = open(log_path, "ab", buffering=0)
    for line in bound_lines:
        log_f.write(f"{line}\n".encode())
    map_path = HERE / "debuglog_map.toml"
    rules = load_rules(map_path) if map_path.is_file() else []
    try:
        child = subprocess.Popen(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0
        )
    except OSError as e:
        log_f.close()
        print(f"bitcoind: failed to start node: {e}", file=sys.stderr)
        return 1

    def _pump() -> None:
        assert child.stdout is not None
        for raw in iter(child.stdout.readline, b""):
            log_f.write(raw)
            text = raw.decode("utf-8", errors="replace")
            for mapped in apply_line(text, rules):
                log_f.write((mapped + "\n").encode())
            log_f.flush()

    pump = threading.Thread(target=_pump, daemon=True)
    pump.start()

    cookie_path = node_dir / ".cookie"
    node_url = f"http://127.0.0.1:{node_rpc_port(public_rpc)}"

    def _cookie() -> str | None:
        try:
            text = cookie_path.read_text()
        except OSError:
            return None
        line = text.strip()
        return line or None

    proxy = RpcProxy(("127.0.0.1", public_rpc), node_url, _cookie)
    register_utility(proxy)
    register_wallet(proxy, f"http://127.0.0.1:{esplora_port(public_rpc)}")
    # Gate getblockstats on Core blocks/blk00000.dat presence (harness only).
    blk0 = node_dir / "blocks" / "blk00000.dat"

    def _getblockstats(params: object) -> object:
        from rpc_proxy import RpcError

        if not blk0.is_file():
            raise RpcError(-1, "Block not found on disk")
        reply = proxy.forward(
            {"method": "getblockstats", "params": params, "id": 0}
        )
        if reply.get("error"):
            err = reply["error"]
            raise RpcError(err.get("code", -1), err.get("message", "error"))
        return reply.get("result")

    proxy.register("getblockstats", _getblockstats)
    try:
        proxy.start()
    except OSError as e:
        child.terminate()
        child.wait(timeout=5)
        log_f.close()
        print(f"bitcoind: proxy listen 127.0.0.1:{public_rpc}: {e}", file=sys.stderr)
        return 1

    def _forward(signum: int, _frame: object) -> None:
        try:
            child.send_signal(signum)
        except OSError:
            pass

    signal.signal(signal.SIGTERM, _forward)
    signal.signal(signal.SIGINT, _forward)
    rc = child.wait()
    proxy.shutdown()
    pump.join(timeout=2)
    log_f.close()
    if rc:
        try:
            with log_path.open("rb") as f:
                f.seek(prior)
                text = f.read().decode("utf-8", errors="replace")
        except OSError:
            text = ""
        errs = [ln for ln in text.splitlines() if ln.startswith("Error:")]
        # Core InitError FULL_TEXT for a tip more than 2h ahead of -mocktime.
        if "appears to be from the future" in text:
            print(
                "The block database contains a block which appears to be from the future."
                " This may be due to your computer's date and time being set incorrectly."
                " Only rebuild the block database if you are sure that your computer's date and time are correct.\n"
                "Please restart with -reindex or -reindex-chainstate to recover.",
                file=sys.stderr,
            )
        elif errs:
            print("\n".join(errs), file=sys.stderr)
    return int(rc) if rc is not None else 1


if __name__ == "__main__":
    sys.exit(main())
