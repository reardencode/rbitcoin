def node_args(key: str, val: str | None) -> list[str]:
    """Map one Core flag onto rbitcoin-node argv (kebab; no Core aliases)."""
    if key == "maxconnections":
        if val is None:
            return ["--max-inbound"]
        try:
            n = inbound_from_maxconnections(int(val))
        except ValueError:
            return [f"--max-inbound={val}"]
        return [f"--max-inbound={n}"]
    if key == "uacomment":
        return [f"--ua-comment={val or ''}"]
    name = CORE_TO_NODE.get(key, key)
    if val is None:
        return [f"--{name}"]
    return [f"--{name}={val}"]


def read_conf(path: Path) -> dict[str, str]:
    """Read bitcoin.conf. Later [section] keys override earlier ones."""
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or line.startswith("["):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        out[k.strip().lower()] = v.strip()
    return out


def read_conf_binds(path: Path) -> list[str]:
    """Repeatable `bind=` lines (TestNode extra_conf `bind=127.0.0.1`)."""
    return read_conf_keys(path, "bind")


def read_conf_keys(path: Path, key: str) -> list[str]:
    out: list[str] = []
    if not path.is_file():
        return out
    want = key.lower()
    for raw in path.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line or line.startswith("["):
            continue
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        if k.strip().lower() == want:
            out.append(v.strip())
    return out


def hold_exclusive_dir(path: Path, held: list[int]) -> None:
    """Keep PATH/.lock exclusive for this shim process (`feature_filelock`)."""
    path.mkdir(parents=True, exist_ok=True)
    lock_path = path / ".lock"
    try:
        fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
    except OSError:
        print(
            f"Error: Cannot obtain a lock on directory {path}. Bitcoin Core is probably already running.",
            file=sys.stderr,
        )
        raise SystemExit(1)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        print(
            f"Error: Cannot obtain a lock on directory {path}. Bitcoin Core is probably already running.",
            file=sys.stderr,
        )
        raise SystemExit(1)
    held.append(fd)


def check_whitebind_addr(val: str) -> None:
    bind = val.rsplit("@", 1)[-1].split("=", 1)[0]
    if "/" in bind:
        print(f"Error: Cannot resolve -whitebind address: '{bind}'", file=sys.stderr)
        raise SystemExit(1)
    if ":" not in bind:
        print(f"Error: Need to specify a port with -whitebind: '{bind}'", file=sys.stderr)
        raise SystemExit(1)
    _host, _, port_s = bind.rpartition(":")
    try:
        port = int(port_s)
    except ValueError:
        print(f"Error: Cannot resolve -whitebind address: '{bind}'", file=sys.stderr)
        raise SystemExit(1)
    if port == 0:
        print(f"Error: Need to specify a port with -whitebind: '{bind}'", file=sys.stderr)
        raise SystemExit(1)


def apply_whitebind(
    val: str,
    binds: list[tuple[str, int | None, bool]],
    extra_node_args: list[str],
) -> None:
    check_whitebind_addr(val)
    extra_node_args.extend(node_args("whitebind", val))
    hostport = val.rsplit("@", 1)[-1]
    host, bport, onion = _parse_bind(hostport)
    binds.append((host, bport, onion))


def listen_targets(
    binds: list[tuple[str, int | None, bool]],
    port_n: int,
) -> list[str]:
    """Core `-bind`/`-port` → the sockets we pass as `--listen`."""
    seen: list[str] = []

    def add(addr: str) -> None:
        if addr in seen:
            print("Error: Duplicate binding configuration", file=sys.stderr)
            raise SystemExit(1)
        seen.append(addr)

    non_onion = [(h, p) for (h, p, o) in binds if not o]
    onion = [(h, p) for (h, p, o) in binds if o]
    if non_onion:
        for host, bport in non_onion:
            add(f"{host}:{bport if bport is not None else port_n}")
    elif not onion:
        # Bare `-port` (no `-bind`): Core binds 0.0.0.0. Onion-only `-bind=…=onion`
        # must not also take the default any-addr socket (feature_bind_extra).
        add(f"0.0.0.0:{port_n}")
    if onion:
        for host, bport in onion:
            h = "127.0.0.1" if host in ("0.0.0.0", "::") else host
            add(f"{h}:{bport if bport is not None else port_n + 1}")
    elif not non_onion:
        add(f"127.0.0.1:{port_n + 1}")
    return seen


def proxy_bind_host(rpcbind: str) -> str:
    """Helm `rpcbind=0.0.0.0` / `[::]` binds the test proxy all-interfaces."""
    host = (rpcbind or "").strip()
    if host.startswith("["):
        inner = host[1:].split("]", 1)[0]
        if inner in ("::", "::0"):
            return "0.0.0.0"
    else:
        h = host.split(":", 1)[0]
        if h in ("0.0.0.0", "::"):
            return "0.0.0.0"
    return "127.0.0.1"


def maybe_seed_store(node_dir: Path) -> None:
    """Copy the rbitcoin 199-block store into a Core cache-shaped datadir.

    Core `_initialize_chain` copies `blocks/` + `chainstate/` then starts the
    node. Those empty dirs are the signal that this is a cached start, not a
    clean chain. We never copy Core LevelDB; only our `store/`.
    """
    cache = os.environ.get("RBITCOIN_CACHE")
    if not cache:
        return
    src = Path(cache) / "store"
    dest = node_dir / "store"
    if dest.exists() or not src.is_dir():
        return
    if not ((node_dir / "blocks").is_dir() and (node_dir / "chainstate").is_dir()):
        return
    shutil.copytree(src, dest)


def find_node() -> Path:
    env = os.environ.get("RBITCOIN_NODE")
    if env:
        p = Path(env)
        if not p.is_absolute():
            p = ROOT / p
        if p.is_file():
            return p
        raise SystemExit(f"RBITCOIN_NODE={env} is not a file")
    cands: list[Path] = []
    td = os.environ.get("CARGO_TARGET_DIR")
    if td:
        cands += [Path(td) / "debug" / "rbitcoin-node", Path(td) / "release" / "rbitcoin-node"]
    cands += [
        ROOT / "target/dev/debug/rbitcoin-node",
        ROOT / "target/debug/rbitcoin-node",
    ]
    for c in cands:
        if c.is_file() and os.access(c, os.X_OK):
            return c
    which = shutil.which("rbitcoin-node")
    if which:
        return Path(which)
    raise SystemExit(
        "rbitcoin-node not found; set RBITCOIN_NODE or cargo build -p rbitcoin-node"
    )


_LOG_RANK = {
    "error": 1,
    "warn": 2,
    "warning": 2,
    "info": 3,
    "debug": 4,
    "trace": 5,
}


def _more_verbose_log_level(cur: str | None, new: str) -> str | None:
    if new not in _LOG_RANK:
        return cur
    if cur is None or _LOG_RANK[new] > _LOG_RANK.get(cur, 0):
        return new
    return cur


def _parse_bind(val: str) -> tuple[str, int | None, bool]:
    """Parse Core -bind=HOST[:PORT][=onion] → (host, port_or_None, is_onion)."""
    onion = "=onion" in val
    hostport = val.split("=", 1)[0]
    if ":" in hostport:
        host, port_s = hostport.rsplit(":", 1)
        try:
            return host, int(port_s), onion
        except ValueError:
            return hostport, None, onion
    return hostport, None, onion


def translate(
    argv: list[str],
) -> tuple[list[str], Path, int, Path | None, list[str], bool, list[int], str]:
    """Return (node argv, datadir, rpcport, blocksdir, bound_lines, rpc_proxy, lock_fds, proxy_host)."""
    datadir: Path | None = None
    rpcport: str | None = None
    p2pport: str | None = None
    network = "regtest"
    log_level: str | None = None
    want_help = False
    want_version = False
    extra_node_args: list[str] = []
    wipe_mempool = False
    blocksdir_arg: Path | None = None
    argv_binds: list[tuple[str, int | None, bool]] = []
    listen_off = False
    whitebind_vals: list[str] = []
    rpc_proxy = True
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("--print-cmd",):
            i += 1
            continue
        key, val = parse_kv(a)
        # Core `-nofoo` / `-nofoo=1` is foo=false; `-nofoo=0` is foo=true.
        no_bases = FORWARD_FLAGS | IGNORE_FLAGS | {"txindex", "maxconnections"}
        if key.startswith("no") and key[2:] in no_bases:
            base = key[2:]
            if val is None or str(val).lower() in ("1", "true", "yes", "on"):
                key, val = base, "0"
            elif str(val).lower() in ("0", "false", "no", "off"):
                key, val = base, "1"
            else:
                key, val = base, "0"
        if val is None and key in (
            "datadir",
            "rpcport",
            "port",
            "bind",
            "whitebind",
            "uacomment",
            "loglevel",
            "conf",
            "testactivationheight",
            "whitelist",
            "minrelaytxfee",
            "limitclustercount",
            "limitclustersize",
            "peertimeout",
            "externalip",
            "maxconnections",
            "minimumchainwork",
            "maxtipage",
            "mocktime",
            "blockversion",
            "blockmintxfee",
            "blockmaxweight",
            "blockreservedweight",
            "stopatheight",
            "blocksdir",
            "walletdir",
            "wallet",
            "checkblocks",
        ):
            i += 1
            if i >= len(argv):
                raise SystemExit(f"bitcoind: {a} requires a value")
            val = argv[i]
        if key == "datadir":
            datadir = Path(val or "")
        elif key == "blocksdir":
            blocksdir_arg = Path(val or "")
            if not blocksdir_arg.is_dir():
                print(
                    f'Error: Specified blocks directory "{blocksdir_arg}" does not exist.',
                    file=sys.stderr,
                )
                raise SystemExit(1)
        elif key == "rpcport":
            rpcport = parse_port(val, "-rpcport")
        elif key == "port":
            p2pport = parse_port(val, "-port")
        elif key == "bind" and val:
            host, bport, onion = _parse_bind(val)
            argv_binds.append((host, bport, onion))
            # Non-onion bind with an explicit port supplies the P2P listen port.
            if not onion and bport is not None:
                p2pport = str(bport)
        elif key == "whitebind" and val:
            whitebind_vals.append(val)
            hostport = val.rsplit("@", 1)[-1]
            _h, bport, onion = _parse_bind(hostport)
            if not onion and bport is not None:
                p2pport = str(bport)
        elif key == "regtest":
            network = "regtest"
        elif key == "uacomment":
            extra_node_args.extend(node_args(key, val))
        elif key in ("h", "help"):
            want_help = True
        elif key == "version":
            want_version = True
        elif key == "debug":
            log_level = _more_verbose_log_level(log_level, "debug")
        elif key == "loglevel" and val and ":" not in val:
            log_level = _more_verbose_log_level(log_level, val.lower())
        elif key == "txindex":
            # Class A always looks up by txid. `-txindex` / `=1` is already true.
            # `-txindex=0` cannot be honored.
            if val is not None and val.lower() in ("0", "false", "off", "no"):
                print("Error parsing command line arguments", file=sys.stderr)
                raise SystemExit(1)
        elif key == "persistmempool":
            # Core -persistmempool=0 skips load/dump; wipe so a later default
            # restart cannot reload a stale dump (mining_basic.py).
            if val is not None and str(val).lower() in ("0", "false", "off", "no"):
                wipe_mempool = True
            extra_node_args.extend(node_args(key, val))
        elif key == "listen":
            v = "1" if val is None else str(val).lower()
            listen_off = v in ("0", "false", "off", "no")
        elif key == "server":
            v = "1" if val is None else str(val).lower()
            if v in ("0", "false", "off", "no"):
                rpc_proxy = False
        elif key == "wallet":
            print("Error parsing command line arguments", file=sys.stderr)
            raise SystemExit(1)
        elif key in IGNORE_FLAGS:
            pass
        elif key in FORWARD_FLAGS:
            extra_node_args.extend(node_args(key, val))
        elif key == "maxconnections":
            extra_node_args.extend(node_args(key, val))
        else:
            print("Error parsing command line arguments", file=sys.stderr)
            raise SystemExit(1)
        i += 1

    if want_help:
        print("Options")
        print("rbitcoin-node (test-only bitcoind shim)")
        raise SystemExit(0)
    if want_version:
        print("rbitcoin-node version")
        raise SystemExit(0)

    if datadir is None:
        env_dd = os.environ.get("BITCOIN_DATA")
        if env_dd:
            datadir = Path(env_dd)
        else:
            raise SystemExit("bitcoind: -datadir is required")

    conf = read_conf(datadir / "bitcoin.conf")
    if conf.get("regtest") in ("1", "true"):
        network = "regtest"
    if rpcport is None:
        rpcport = parse_port(conf.get("rpcport") or "18443", "-rpcport")
    if p2pport is None:
        p2pport = parse_port(conf.get("port") or "18444", "-port")

    conf_binds = [_parse_bind(v) for v in read_conf_binds(datadir / "bitcoin.conf")]
    for v in read_conf_keys(datadir / "bitcoin.conf", "whitebind"):
        if not v:
            continue
        whitebind_vals.append(v)
        hostport = v.rsplit("@", 1)[-1]
        _h, bport, onion = _parse_bind(hostport)
        if p2pport is None and not onion and bport is not None:
            p2pport = str(bport)
    binds = conf_binds + argv_binds

    if listen_off and (binds or whitebind_vals):
        print(
            "Error: Cannot set -bind or -whitebind together with -listen=0",
            file=sys.stderr,
        )
        raise SystemExit(1)

    for v in whitebind_vals:
        apply_whitebind(v, binds, extra_node_args)

    node_dir = datadir / network
    node_dir.mkdir(parents=True, exist_ok=True)
    pw = conf.get("rpcpassword") or ""
    if pw:
        tok = node_dir / "rpc.token"
        tok.write_text(pw + "\n")
        tok.chmod(0o600)
    maybe_seed_store(node_dir)

    mp = node_dir / "mempool"
    marker = node_dir / ".rbitcoin-nopersistmempool"
    # Core -persistmempool=0 is RAM-only; our store still coalesces admits.
    # Wipe on =0 start, and once more on the next default start so a stale
    # dump cannot reload (mining_basic.py empty-mempool gate).
    if wipe_mempool or marker.is_file():
        if mp.exists():
            shutil.rmtree(mp, ignore_errors=True)
        if wipe_mempool:
            marker.write_text("1\n")
        else:
            marker.unlink(missing_ok=True)
    # Core-layout placeholders: dummy blocks/blk00000.dat for getblockstats
    # rename; with -blocksdir, also blk under blocksdir/<network>/blocks.
    # The node has no blocks/ product — extra -blocksdir flock is shim-only.
    lock_fds: list[int] = []
    blocks_dir = node_dir / "blocks"
    blocks_dir.mkdir(parents=True, exist_ok=True)
    (blocks_dir / "index").mkdir(parents=True, exist_ok=True)
    blk0 = blocks_dir / "blk00000.dat"
    if not blk0.is_file():
        blk0.write_bytes(b"\x00" * 16)
    if blocksdir_arg is not None:
        bd_blocks = blocksdir_arg / network / "blocks"
        bd_blocks.mkdir(parents=True, exist_ok=True)
        bd_blk = bd_blocks / "blk00000.dat"
        if not bd_blk.is_file():
            bd_blk.write_bytes(b"\x00" * 16)
        hold_exclusive_dir(bd_blocks, lock_fds)

    node = find_node()
    port_n = int(p2pport)
    listens = listen_targets(binds, port_n)
    if not listens:
        listens = [f"127.0.0.1:{port_n}"]
    proxy_host = proxy_bind_host(conf.get("rpcbind") or "")
    cmd = [
        str(node),
        "--network",
        network,
        "--datadir",
        str(node_dir),
        "--rpc-listen",
        f"127.0.0.1:{node_rpc_port(int(rpcport))}",
        "--listen",
        listens[0],
        "--no-seeds",
        "--sh-index",
        "--esplora-listen",
        f"127.0.0.1:{esplora_port(int(rpcport))}",
    ]
    for extra in listens[1:]:
        cmd += ["--listen", extra]
    if log_level:
        cmd += ["--log-level", log_level]
    cmd += extra_node_args

    bound_lines = [f"Bound to {addr}" for addr in listens]

    return (
        cmd,
        node_dir,
        int(rpcport),
        blocksdir_arg,
        bound_lines,
        rpc_proxy,
        lock_fds,
        proxy_host,
    )


def emit_child_init_errors(log_path: Path, prior: int, rules: list) -> None:
    """Copy Core-shaped InitError needles from the node's debug.log to stderr."""
    try:
        with log_path.open("rb") as f:
            f.seek(prior)
            text = f.read().decode("utf-8", errors="replace")
    except OSError:
        text = ""
    errs = [ln for ln in text.splitlines() if ln.startswith("Error:")]
    # Core InitError FULL_TEXT for a tip more than 2h ahead of -mocktime.
    if "appears to be from the future" in text:
        print(
            "The block database contains a block which appears to be from the future."
            " This may be due to your computer's date and time being set incorrectly."
            " Only rebuild the block database if you are sure that your computer's date and time are correct.\n"
            "Please restart with -reindex or -reindex-chainstate to recover.",
            file=sys.stderr,
        )
    elif errs:
        print("\n".join(map_error_stderr(errs, rules)), file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv if argv is None else argv)
    print_cmd = "--print-cmd" in argv
    (
        cmd,
        node_dir,
        public_rpc,
        _blocksdir_arg,
        bound_lines,
        rpc_proxy,
        _lock_fds,
        proxy_host,
    ) = translate(argv)
    pid_path = node_dir / "bitcoind.pid"
    if print_cmd:
        print(" ".join(cmd))
        print(f"pidfile {pid_path}", file=sys.stderr)
        print(f"proxy {proxy_host}:{public_rpc}", file=sys.stderr)
        return 0
    pid_path.write_text(f"{os.getpid()}\n")
    # TestNode tails this process's stderr and requires it empty on a clean
    # stop. Core writes logs to debug.log (printtoconsole=0). Keep that shape:
    # node stdio → {datadir}/debug.log; only `Error:` lines on shim stderr.
    log_path = node_dir / "debug.log"
    prior = log_path.stat().st_size if log_path.is_file() else 0
    log_f = open(log_path, "ab", buffering=0)
    for line in bound_lines:
        log_f.write(f"{line}\n".encode())
    map_path = HERE / "debuglog_map.toml"
    rules = load_rules(map_path) if map_path.is_file() else []
    child_env = os.environ.copy()
    child_env["RBITCOIN_RPC_WAIT_TIP_IDLE"] = "1"
    try:
        child = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=0,
            env=child_env,
        )
    except OSError as e:
        log_f.close()
        print(f"bitcoind: failed to start node: {e}", file=sys.stderr)
        return 1

    def _pump() -> None:
        assert child.stdout is not None
        for raw in iter(child.stdout.readline, b""):
            log_f.write(raw)
            text = raw.decode("utf-8", errors="replace")
            for mapped in apply_line(text, rules):
                log_f.write((mapped + "\n").encode())
            log_f.flush()

    pump = threading.Thread(target=_pump, daemon=True)
    pump.start()

    cookie_path = node_dir / ".cookie"
    token_path = node_dir / "rpc.token"
    node_url = f"http://127.0.0.1:{node_rpc_port(public_rpc)}"
    cookie_mtime0 = cookie_path.stat().st_mtime if cookie_path.is_file() else None

    def _mirror_cookie() -> None:
        last = None
        while child.poll() is None:
            try:
                tok = token_path.read_text().strip()
            except OSError:
                tok = ""
            if tok and tok != last:
                line = f"__cookie__:{tok}\n"
                try:
                    cookie_path.write_text(line)
                    cookie_path.chmod(0o600)
                except OSError:
                    pass
                last = tok
            time.sleep(0.05)

    mirror = threading.Thread(target=_mirror_cookie, daemon=True)
    mirror.start()

    def _cookie() -> str | None:
        try:
            text = cookie_path.read_text()
        except OSError:
            text = ""
        line = text.strip()
        if line:
            return line
        try:
            tok = token_path.read_text().strip()
        except OSError:
            return None
        if not tok:
            return None
        return f"__cookie__:{tok}"

    def _cookie_rewritten() -> bool:
        if not cookie_path.is_file():
            return False
        if cookie_mtime0 is None:
            return True
        return cookie_path.stat().st_mtime > cookie_mtime0

    def _child_init_exit() -> int:
        pump.join(timeout=2)
        log_f.close()
        rc = child.returncode
        if rc:
            emit_child_init_errors(log_path, prior, rules)
        return int(rc) if rc is not None else 1

    # Wait for a *new* cookie or InitError. feature_filelock.py starts a second
    # TestNode with the live node's -datadir (leftover cookie + same rpcport).
    deadline = time.monotonic() + 120
    while child.poll() is None and rpc_proxy and not _cookie_rewritten():
        if time.monotonic() > deadline:
            break
        time.sleep(0.05)
    if child.poll() is not None or not rpc_proxy:
        if child.poll() is None:
            child.wait()
        return _child_init_exit()

    try:
        proxy = RpcProxy((proxy_host, public_rpc), node_url, _cookie)
    except OSError:
        if child.poll() is None:
            child.terminate()
            child.wait(timeout=5)
        return _child_init_exit()
    register_utility(proxy)
    register_wallet(proxy, f"http://127.0.0.1:{esplora_port(public_rpc)}")
    # Gate getblockstats on Core blocks/blk00000.dat presence (harness only).
    blk0 = node_dir / "blocks" / "blk00000.dat"

    def _getblockstats(params: object) -> object:
        from rpc_proxy import RpcError

        if not blk0.is_file():
            raise RpcError(-1, "Block not found on disk")
        reply = proxy.forward(
            {"method": "getblockstats", "params": params, "id": 0}
        )
        if reply.get("error"):
            err = reply["error"]
            raise RpcError(err.get("code", -1), err.get("message", "error"))
        return reply.get("result")

    proxy.register("getblockstats", _getblockstats)
    try:
        proxy.start()
    except OSError:
        child.terminate()
        child.wait(timeout=5)
        return _child_init_exit()

    def _forward(signum: int, _frame: object) -> None:
        try:
            child.send_signal(signum)
        except OSError:
            pass

    signal.signal(signal.SIGTERM, _forward)
    signal.signal(signal.SIGINT, _forward)
    rc = child.wait()
    proxy.shutdown()
    pump.join(timeout=2)
    log_f.close()
    if rc:
        emit_child_init_errors(log_path, prior, rules)
    return int(rc) if rc is not None else 1


if __name__ == "__main__":
    sys.exit(main())
