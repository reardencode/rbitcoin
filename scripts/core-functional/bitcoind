def parse_kv(arg: str) -> tuple[str, str | None]:
    a = arg[1:] if arg.startswith("-") else arg
    # Core uses -name or -name=value (one dash). Allow --name too.
    a = a[1:] if a.startswith("-") else a
    if "=" in a:
        k, v = a.split("=", 1)
        return k, v
    return a, None


def parse_port(raw: str | None, flag: str) -> str:
    s = "" if raw is None else str(raw)
    if re.fullmatch(r"[0-9]+", s) is None:
        print(f"Error: Invalid port specified in {flag}: '{s}'", file=sys.stderr)
        raise SystemExit(1)
    n = int(s)
    if n < 1 or n > 65535:
        print(f"Error: Invalid port specified in {flag}: '{s}'", file=sys.stderr)
        raise SystemExit(1)
    return str(n)


