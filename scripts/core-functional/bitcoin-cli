#!/usr/bin/env python3
"""Test-only bitcoin-cli → cookie JSON-RPC. Not the operator CLI.

`mining_template_verification.py` calls `node.cli.getblocktemplate(...)` in
parallel. Core's TestNodeCLI shells out to this binary.
"""

from __future__ import annotations

import base64
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


def parse_kv(arg: str) -> tuple[str, str | None]:
    a = arg[1:] if arg.startswith("-") else arg
    a = a[1:] if a.startswith("-") else a
    if "=" in a:
        k, v = a.split("=", 1)
        return k, v
    return a, None


def conf_value(datadir: Path, key: str) -> str | None:
    for name in ("bitcoin.conf", "regtest/bitcoin.conf"):
        p = datadir / name
        if not p.is_file():
            continue
        for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == key:
                return v.strip()
    return None


def cookie_auth(datadir: Path) -> str | None:
    for p in (datadir / "regtest" / ".cookie", datadir / ".cookie"):
        if p.is_file():
            return p.read_text(encoding="utf-8").strip()
    return None


def default_datadir() -> Path | None:
    env = os.environ.get("BITCOIN_DATA")
    if env:
        return Path(env)
    home = os.environ.get("HOME")
    if home:
        p = Path(home) / ".bitcoin"
        if p.is_dir():
            return p
    return None


def main(argv: list[str]) -> int:
    datadir: Path | None = None
    rpcport: int | None = None
    named = False
    use_stdin = False
    positional: list[str] = []
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "-stdin":
            use_stdin = True
            i += 1
            continue
        if a == "-named":
            named = True
            i += 1
            continue
        if a == "-nonamed":
            named = False
            i += 1
            continue
        if a.startswith("-"):
            k, v = parse_kv(a)
            if k == "datadir":
                datadir = Path(v or "")
            elif k == "rpcport" and v:
                rpcport = int(v)
            i += 1
            continue
        positional.append(a)
        i += 1

    if use_stdin:
        extra = sys.stdin.read().splitlines()
        positional.extend(x for x in extra if x)

    if not positional:
        print("too few parameters (need at least command)", file=sys.stderr)
        return 1
    if datadir is None:
        datadir = default_datadir()
    if datadir is None:
        print("error: -datadir is required", file=sys.stderr)
        return 1

    if rpcport is None:
        v = conf_value(datadir, "rpcport")
        if v:
            rpcport = int(v)
    if rpcport is None:
        print("error: no rpcport", file=sys.stderr)
        return 1

    method = positional[0]
    args = positional[1:]
    if named:
        params: dict | list = {}
        for a in args:
            if "=" not in a:
                print(f"error: named argument expected, got {a!r}", file=sys.stderr)
                return 1
            k, v = a.split("=", 1)
            try:
                params[k] = json.loads(v)
            except json.JSONDecodeError:
                params[k] = v
    else:
        params = []
        for a in args:
            try:
                params.append(json.loads(a))
            except json.JSONDecodeError:
                params.append(a)

    cookie = cookie_auth(datadir)
    body = json.dumps({"jsonrpc": "1.0", "id": "cli", "method": method, "params": params}).encode()
    req = urllib.request.Request(
        f"http://127.0.0.1:{rpcport}/",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    if cookie:
        tok = base64.b64encode(cookie.encode()).decode()
        req.add_header("Authorization", f"Basic {tok}")
    else:
        user = conf_value(datadir, "rpcuser") or "user"
        password = conf_value(datadir, "rpcpassword")
        if password:
            tok = base64.b64encode(f"{user}:{password}".encode()).decode()
            req.add_header("Authorization", f"Basic {tok}")
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        raw = e.read().decode() if e.fp else ""
        if not raw:
            print(f"error: {e}", file=sys.stderr)
            return 1
        try:
            json.loads(raw)
        except json.JSONDecodeError:
            text = raw if raw.endswith("\n") else raw + "\n"
            print(f"error: Server response: {text}", end="", file=sys.stderr)
            return 1
    except OSError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    try:
        msg = json.loads(raw)
    except json.JSONDecodeError:
        print(raw)
        return 0
    if msg.get("error"):
        err = msg["error"]
        code = err.get("code", -1)
        message = err.get("message", "")
        print(f"error code: {code}\nerror message:\n{message}", file=sys.stderr)
        return 1
    result = msg.get("result")
    if result is None:
        return 0
    print(json.dumps(result, default=str))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
